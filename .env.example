# Copy to server/.env (local) and set the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# MongoDB Atlas (cluster finance-btl, AWS us-east-1). Database name: finance (prod) / finance_dev (local)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/finance?retryWrites=true&w=majority&appName=finance-btl
# Optional: overrides the database name in the URI (worktrees: finance_wt<n>, staging: finance_staging, production: finance)
MONGODB_DB=

# Auth
JWT_ACCESS_SECRET=<openssl rand -hex 32>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
APP_URL=https://<project>.vercel.app

# Telegram bot @sochitieu_btl_bot (token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=sochitieu_btl_bot
TELEGRAM_WEBHOOK_SECRET=<openssl rand -hex 24>

# Zalo bot (token arrives as a Zalo message after creating the bot in Zalo Bot Creator)
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET=<openssl rand -hex 24>
# The bot's share link (Zalo Bot Creator), opened by the web link card's "Copy & open Zalo" button.
# https, at most 106 bytes (it also goes into the card's QR code). Optional.
ZALO_BOT_URL=

# WhatsApp bot number for wa.me links on the web link card: international format, digits only (no + or leading 0). Optional.
WHATSAPP_NUMBER=

# WhatsApp bot on Meta's Cloud API (docs/06 §6.12). Optional, but all four are needed: with one missing the webhook
# answers 503 and the link card hides WhatsApp. Set them with tools/set-secret.sh.
# Permanent access token of a Meta system user
WHATSAPP_ACCESS_TOKEN=
# Phone number ID of the business number (digits only; not the WhatsApp Business account ID)
WHATSAPP_PHONE_NUMBER_ID=
# App secret (App settings -> Basic): signs every webhook POST
WHATSAPP_APP_SECRET=
# You choose it: openssl rand -hex 24. Paste the same value into Meta's "Verify token" field
WHATSAPP_VERIFY_TOKEN=<openssl rand -hex 24>

# Email codes through Gmail SMTP (docs/02 §2.12, docs/06 §6.14). Optional; both are needed for mail.
# Set ONLY in the Vercel dashboard of both projects, never here: worktrees copy server/.env and would send real mail.
# Keep both empty locally: the code is then written to the server log instead of sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Receipt KIE service (Docker + Cloudflare Tunnel)
# KIE_URL is what the local server calls; KIE_PUBLIC_URL is the tunnel, pushed to Vercel as KIE_URL.
# Keep comments on their own lines: a value never carries a "# ..." comment.
KIE_URL=http://localhost:<port>
KIE_PUBLIC_URL=https://<random>.trycloudflare.com
KIE_API_KEY=<openssl rand -hex 24>

# Seeding only (local, never on Vercel)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
