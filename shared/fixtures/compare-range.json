{
  "about": "One comparison rule for the Dashboard and the assistant (docs/02 §2.11.3). Dates are Vietnam calendar days, 'YYYY-MM-DD', both ends included. compareRange: the period before { from, to } for a unit (day, week, month, year) or, when unit is null, the unit the dates imply. monthCompare: the Dashboard's MonthCompare ranges for the selected month on the day 'today'; its previous range must equal compareRange(current, 'month').",
  "compareRange": [
    { "name": "Mon 23 to Wed 25/11 is a week", "from": "2026-11-23", "to": "2026-11-25", "unit": null, "previous": { "from": "2026-11-16", "to": "2026-11-18" } },
    { "name": "a whole Monday-to-Sunday week", "from": "2026-11-23", "to": "2026-11-29", "unit": null, "previous": { "from": "2026-11-16", "to": "2026-11-22" } },
    { "name": "01 to 25/11 is a month to date", "from": "2026-11-01", "to": "2026-11-25", "unit": null, "previous": { "from": "2026-10-01", "to": "2026-10-25" } },
    { "name": "01 to 31/10 is October; September has 30 days", "from": "2026-10-01", "to": "2026-10-31", "unit": null, "previous": { "from": "2026-09-01", "to": "2026-09-30" } },
    { "name": "01 to 31/03, leap year: February has 29 days", "from": "2024-03-01", "to": "2024-03-31", "unit": null, "previous": { "from": "2024-02-01", "to": "2024-02-29" } },
    { "name": "01 to 30/03, leap year: the 30th is capped at 29/02", "from": "2024-03-01", "to": "2024-03-30", "unit": null, "previous": { "from": "2024-02-01", "to": "2024-02-29" } },
    { "name": "01 to 31/03, normal year: February has 28 days", "from": "2026-03-01", "to": "2026-03-31", "unit": null, "previous": { "from": "2026-02-01", "to": "2026-02-28" } },
    { "name": "01 to 30/03, normal year: the 30th is capped at 28/02", "from": "2026-03-01", "to": "2026-03-30", "unit": null, "previous": { "from": "2026-02-01", "to": "2026-02-28" } },
    { "name": "01 to 29/03, leap year: not capped", "from": "2024-03-01", "to": "2024-03-29", "unit": null, "previous": { "from": "2024-02-01", "to": "2024-02-29" } },
    { "name": "a whole 28-day February is compared with the whole of January", "from": "2026-02-01", "to": "2026-02-28", "unit": null, "previous": { "from": "2026-01-01", "to": "2026-01-31" } },
    { "name": "a whole April is compared with the whole of March", "from": "2026-04-01", "to": "2026-04-30", "unit": null, "previous": { "from": "2026-03-01", "to": "2026-03-31" } },
    { "name": "01 to 29/04 is not a whole month: same days", "from": "2026-04-01", "to": "2026-04-29", "unit": null, "previous": { "from": "2026-03-01", "to": "2026-03-29" } },
    { "name": "January goes back to December of the year before", "from": "2026-01-01", "to": "2026-01-31", "unit": null, "previous": { "from": "2025-12-01", "to": "2025-12-31" } },
    { "name": "01 to 10/01 is a month to date, not a year", "from": "2026-01-01", "to": "2026-01-10", "unit": null, "previous": { "from": "2025-12-01", "to": "2025-12-10" } },
    { "name": "one day is a day", "from": "2026-11-25", "to": "2026-11-25", "unit": null, "previous": { "from": "2026-11-24", "to": "2026-11-24" } },
    { "name": "the first of a month is a day, not a month", "from": "2026-12-01", "to": "2026-12-01", "unit": null, "previous": { "from": "2026-11-30", "to": "2026-11-30" } },
    { "name": "the day after 28/02 in a leap year", "from": "2024-03-01", "to": "2024-03-01", "unit": null, "previous": { "from": "2024-02-29", "to": "2024-02-29" } },
    { "name": "a Monday that is also the 1st, one day", "from": "2026-06-01", "to": "2026-06-01", "unit": null, "previous": { "from": "2026-05-31", "to": "2026-05-31" } },
    { "name": "1/1 to 25/11 spans more than a month: a year to date", "from": "2026-01-01", "to": "2026-11-25", "unit": null, "previous": { "from": "2025-01-01", "to": "2025-11-25" } },
    { "name": "a whole year", "from": "2026-01-01", "to": "2026-12-31", "unit": null, "previous": { "from": "2025-01-01", "to": "2025-12-31" } },
    { "name": "1/1 to 29/02, leap year: a year, and 2023 ends 28/02", "from": "2024-01-01", "to": "2024-02-29", "unit": null, "previous": { "from": "2023-01-01", "to": "2023-02-28" } },
    { "name": "01 to 07/06/2026 is a week and a month to date: with no unit the month wins", "from": "2026-06-01", "to": "2026-06-07", "unit": null, "previous": { "from": "2026-05-01", "to": "2026-05-07" } },
    { "name": "the same dates with the unit week", "from": "2026-06-01", "to": "2026-06-07", "unit": "week", "previous": { "from": "2026-05-25", "to": "2026-05-31" } },
    { "name": "the same dates with the unit month", "from": "2026-06-01", "to": "2026-06-07", "unit": "month", "previous": { "from": "2026-05-01", "to": "2026-05-07" } },
    { "name": "a week across the new year", "from": "2026-12-28", "to": "2027-01-03", "unit": "week", "previous": { "from": "2026-12-21", "to": "2026-12-27" } },
    { "name": "a week into March goes back into February", "from": "2026-03-02", "to": "2026-03-04", "unit": "week", "previous": { "from": "2026-02-23", "to": "2026-02-25" } },
    { "name": "three days with the unit day move by one day", "from": "2026-11-23", "to": "2026-11-25", "unit": "day", "previous": { "from": "2026-11-22", "to": "2026-11-24" } },
    { "name": "15 to 25/11 with the unit month", "from": "2026-11-15", "to": "2026-11-25", "unit": "month", "previous": { "from": "2026-10-15", "to": "2026-10-25" } },
    { "name": "the 31st with the unit month is capped at 30/09", "from": "2026-10-31", "to": "2026-10-31", "unit": "month", "previous": { "from": "2026-09-30", "to": "2026-09-30" } },
    { "name": "the 31st with the unit month is capped at 28/02", "from": "2026-03-31", "to": "2026-03-31", "unit": "month", "previous": { "from": "2026-02-28", "to": "2026-02-28" } },
    { "name": "29/02 with the unit year is capped at 28/02", "from": "2024-02-29", "to": "2024-02-29", "unit": "year", "previous": { "from": "2023-02-28", "to": "2023-02-28" } },
    { "name": "10 to 25/11 with the unit year", "from": "2026-11-10", "to": "2026-11-25", "unit": "year", "previous": { "from": "2025-11-10", "to": "2025-11-25" } },
    { "name": "no unit fits (Tuesday, not the 1st): shift by its own length of 3 days", "from": "2026-11-10", "to": "2026-11-12", "unit": null, "previous": { "from": "2026-11-07", "to": "2026-11-09" } },
    { "name": "a Monday start longer than a week: shift by its own length of 10 days", "from": "2026-11-16", "to": "2026-11-25", "unit": null, "previous": { "from": "2026-11-06", "to": "2026-11-15" } },
    { "name": "a range across a month end: shift by its own length of 16 days", "from": "2026-11-20", "to": "2026-12-05", "unit": null, "previous": { "from": "2026-11-04", "to": "2026-11-19" } }
  ],
  "monthCompare": [
