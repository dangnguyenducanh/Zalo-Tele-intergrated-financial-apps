    { "name": "30/03 in a normal year: capped at 28/02", "month": "2026-03", "today": "2026-03-30", "current": { "from": "2026-03-01", "to": "2026-03-30" }, "previous": { "from": "2026-02-01", "to": "2026-02-28" } },
